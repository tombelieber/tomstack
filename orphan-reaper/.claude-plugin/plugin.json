{
  "name": "orphan-reaper",
  "description": "Kill orphan dev processes left by AI agent sessions",
  "version": "0.1.2",
  "author": {
    "name": "tombelieber"
  },
  "repository": "https://github.com/tombelieber/tomstack",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/cli.sh kill --quiet --json 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ]
  }
}
